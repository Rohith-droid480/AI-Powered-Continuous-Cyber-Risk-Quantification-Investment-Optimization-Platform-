<?xml version="1.0" ?>
<NessusClientData_v2>
  <Policy>
    <policyName>Basic Network Scan</policyName>
    <Preferences>
      <ServerPreferences>
        <preference>
          <name>max_hosts</name>
          <value>30</value>
        </preference>
      </ServerPreferences>
    </Preferences>
  </Policy>
  <Report name="Enterprise Perimeter Security Assessment">
    <ReportHost name="192.168.1.10">
      <HostProperties>
        <tag name="HOST_START">Sun Sep 13 00:00:00 2026</tag>
        <tag name="HOST_END">Sun Sep 13 00:05:00 2026</tag>
        <tag name="host-ip">192.168.1.10</tag>
        <tag name="host-fqdn">web-app-gateway.internal.corp</tag>
        <tag name="operating-system">Linux Kernel 5.15</tag>
      </HostProperties>
      <ReportItem port="443" svc_name="https" protocol="tcp" severity="4" pluginID="156014" pluginName="Apache Log4j Remote Code Execution (Log4Shell)" pluginFamily="CGI abuses">
        <description>Apache Log4j2 versions 2.0-beta9 through 2.15.0 JNDI features used in configuration, log messages, and parameters do not protect against attacker controlled LDAP and other JNDI related endpoints. An attacker who can control log messages or log message parameters can execute arbitrary code loaded from LDAP servers when message lookup substitution is enabled.</description>
        <cve>CVE-2021-44228</cve>
        <cvss_base_score>10.0</cvss_base_score>
        <solution>Upgrade to Apache Log4j 2.15.0 or later, or set system property log4j2.formatMsgNoLookups to true.</solution>
      </ReportItem>
      <ReportItem port="80" svc_name="http" protocol="tcp" severity="3" pluginID="153583" pluginName="Apache HTTP Server Path Traversal and File Disclosure" pluginFamily="Web Servers">
        <description>A flaw was found in a change made to path normalization in Apache HTTP Server 2.4.49. An attacker could use a path traversal attack to map URLs to files outside the expected document root. If files outside of these roots are not protected by default require all denied, these requests can succeed.</description>
        <cve>CVE-2021-41773</cve>
        <cvss_base_score>7.5</cvss_base_score>
        <solution>Upgrade to Apache HTTP Server 2.4.50 or later.</solution>
      </ReportItem>
      <ReportItem port="8080" svc_name="http-proxy" protocol="tcp" severity="4" pluginID="97940" pluginName="Apache Struts 2 REST Plugin RCE (S2-045)" pluginFamily="CGI abuses">
        <description>The Jakarta Multipart parser in Apache Struts 2 2.3.x before 2.3.32 and 2.5.x before 2.5.10.1 mishandles Content-Type headers, allowing remote attackers to execute arbitrary commands via a crafted Content-Type value.</description>
        <cve>CVE-2017-5638</cve>
        <cvss_base_score>10.0</cvss_base_score>
        <solution>Upgrade to Apache Struts version 2.3.32 or 2.5.10.1 or later.</solution>
      </ReportItem>
    </ReportHost>
    <ReportHost name="192.168.1.20">
      <HostProperties>
        <tag name="HOST_START">Sun Sep 13 00:05:00 2026</tag>
        <tag name="HOST_END">Sun Sep 13 00:10:00 2026</tag>
        <tag name="host-ip">192.168.1.20</tag>
        <tag name="host-fqdn">dc01.internal.corp</tag>
        <tag name="operating-system">Windows Server 2019</tag>
      </HostProperties>
      <ReportItem port="445" svc_name="cifs" protocol="tcp" severity="4" pluginID="140657" pluginName="Microsoft Netlogon Elevation of Privilege (Zerologon)" pluginFamily="Windows">
        <description>An elevation of privilege vulnerability exists when an attacker establishes a vulnerable Netlogon secure channel connection to a domain controller, using the Netlogon Remote Protocol (MS-NRPC). An unauthenticated attacker who successfully exploited the vulnerability could gain domain administrator access.</description>
        <cve>CVE-2020-1472</cve>
        <cvss_base_score>10.0</cvss_base_score>
        <solution>Apply Microsoft security update KB4571694 or subsequent monthly rollups.</solution>
      </ReportItem>
      <ReportItem port="22" svc_name="ssh" protocol="tcp" severity="1" pluginID="10882" pluginName="SSH Server CBC Mode Ciphers Enabled" pluginFamily="Misc.">
        <description>The SSH server is configured to support Cipher Block Chaining (CBC) encryption mode. This may allow an attacker to recover the plaintext message from the ciphertext.</description>
        <cve>CVE-2008-5161</cve>
        <cvss_base_score>2.6</cvss_base_score>
        <solution>Contact the vendor or consult product documentation to disable CBC mode cipher encryption.</solution>
      </ReportItem>
    </ReportHost>
  </Report>
</NessusClientData_v2>
